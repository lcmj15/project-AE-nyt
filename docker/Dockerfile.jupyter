FROM python:3.12-slim-bookworm

# Java para o Spark (precisa de root)
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pyspark==3.5.3 jupyterlab pandas pyarrow

WORKDIR /work